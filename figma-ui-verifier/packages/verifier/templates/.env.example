# Figma UI Verifier Configuration

# Figma API Token (required for screenshots)
# Get from: Figma → Settings → Personal Access Tokens
FIGMA_TOKEN=

# Figma File Key (from URL: figma.com/file/:key/...)
FIGMA_FILE_KEY=

# Verification threshold (0-100)
VERIFY_THRESHOLD=80

# Viewports to test (comma-separated)
VIEWPORTS=1440,768,375

# Local dev server URL
DEV_URL=http://localhost:3000

# Output paths
REPORT_JSON=./figma-verify-report.json
REPORT_HTML=./figma-verify-report.html
