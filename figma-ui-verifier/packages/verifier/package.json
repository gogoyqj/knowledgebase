{
  "name": "@figma-ui-verifier/verifier",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "figma-verify": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "test:e2e": "vitest run e2e --reporter=verbose",
    "test:e2e:fallback": "E2E_USE_FALLBACK=1 vitest run e2e --reporter=verbose"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "delta-e": "^0.0.8",
    "munkres-js": "^1.2.2",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.0.0",
    "ssim.js": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pixelmatch": "^5.2.0",
    "@types/pngjs": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
